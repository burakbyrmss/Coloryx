{
  "name": "ColoryxRN",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "start:cache": "react-native start --reset-cache",
    "reset-project": "node ./scripts/reset-project.js",
    "bump-version": "node ./scripts/bump-version.js",
    "bump-build": "node ./scripts/bump-build.js",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "ios:pods": "cd ios && pod install && cd ..",
    "ios:clean": "xcodebuild -workspace ios/ColoryxRN.xcworkspace -scheme ColoryxRN -configuration Release clean",
    "ios:archive": "mkdir -p ios/build && xcodebuild -workspace ios/ColoryxRN.xcworkspace -scheme ColoryxRN -configuration Release -sdk iphoneos -archivePath ios/build/ColoryxRN.xcarchive archive",
    "ios:export": "xcodebuild -allowProvisioningUpdates -exportArchive -archivePath ios/build/ColoryxRN.xcarchive -exportPath ios/build/export -exportOptionsPlist ios/exportOptions.appstore.plist",
    "ios:ipa": "npm run ios:archive && npm run ios:export",
    "ios:open:outputs": "open ios/build || true",
    "android:clean": "cd android && ./gradlew clean",
    "android:aab": "cd android && ./gradlew bundleRelease",
    "android:apk": "cd android && ./gradlew assembleRelease",
    "android:open:outputs": "open android/app/build/outputs || true",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-community/slider": "^5.1.2",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@reduxjs/toolkit": "^2.11.2",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-gesture-handler": "^2.30.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.8.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
